# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
#
# Nothing here is required to run the site or the Dev Studio (/studio). Each
# block below unlocks one optional feature:
#
#   ATPROTO_*  — publishing blog posts to AT Protocol, whether from
#                `npm run blog` or the Studio's Publish button
#   R2_*       — uploading podcast audio from the Studio's episode editor
#
# Next reads this file at boot: restart the dev server after changing it.

# --- AT Protocol publishing -------------------------------------------------

# Your Bluesky handle (e.g., yourname.bsky.social or custom domain)
ATPROTO_HANDLE=

# App password from Bluesky settings (Settings > App Passwords)
# Create a new app password specifically for this use case
ATPROTO_APP_PASSWORD=

# Optional: PDS URL (defaults to https://bsky.social)
# ATPROTO_PDS_URL=https://bsky.social

# Publication AT-URI (set after running: npm run create-publication)
# This is required for the /.well-known/site.standard.publication endpoint
# ATPROTO_PUBLICATION_URI=at://did:plc:xxx/site.standard.publication/xxx

# --- Podcast audio upload (dev-only) ----------------------------------------
#
# Only needed to upload episode audio from /studio/podcast. Everything else in
# the Studio works without these. Uploads go to:
#   $R2_BUCKET/off-protocol/<YYYY-MM-DD>-<slug>/<slug>.mp3
# and are served from $R2_PUBLIC_BASE at the same path.

# Uploads go over R2's S3-compatible API, so these are the Access Key ID and
# Secret Access Key from an R2 API token — NOT the "Token value" on that page.
# Scope the token to "Object Read & Write" on the bucket below.
CLOUDFLARE_ACCOUNT_ID=<32-char hex from Cloudflare dashboard>
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
# Name of the R2 bucket that media.atproto.com serves.
R2_BUCKET=<bucket name>
R2_PUBLIC_BASE=https://media.atproto.com
